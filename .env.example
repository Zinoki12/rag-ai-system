# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=127.0.0.1
# 5433 on the host, because 5432 is usually taken by a native install.
POSTGRES_PORT=5433

# --- Ingest -----------------------------------------------------------------
# Absolute path to the markdown vault to index.
VAULT_PATH=

# --- Embeddings -------------------------------------------------------------
# google | ollama | fake
#   google  hosted Gemini API, needs GOOGLE_API_KEY
#   ollama  local model in docker compose, needs `ollama pull <model>`
#   fake    deterministic offline stub, for tests and demos without either
#
# Changing the model or the dimension creates a new vector space with its own
# table, and the next ingest run recomputes everything into it. Nothing is
# destroyed: point the variables back and the old vectors are still there.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Calls per second to the provider; 0 disables the limiter.
EMBED_RPS=
EMBED_BURST=

# --- Generation -------------------------------------------------------------
# google | ollama | stub  (stub answers with the retrieved context, no model)
LLM_PROVIDER=stub
LLM_MODEL=
LLM_RPS=
LLM_BURST=

# --- Providers --------------------------------------------------------------
GOOGLE_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# --- HTTP -------------------------------------------------------------------
HTTP_ADDR=:8081
